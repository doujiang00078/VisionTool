<UserControl
	x:Class="VisionTool.UI.DynamicConfigView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
	xmlns:th="clr-namespace:WHWpf.Theming;assembly=WHWpf.Theming"
	Background="#1C1C26">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/WHWpf.Theming;component/Styles/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="6" />
			<ColumnDefinition Width="430" />
		</Grid.ColumnDefinitions>

		<Border
			Grid.Column="0"
			Margin="4"
			Background="#191970"
			BorderBrush="#2A2A3A"
			BorderThickness="1"
			CornerRadius="4">
			<WindowsFormsHost x:Name="WinFormsHost" />
		</Border>

		<GridSplitter
			Grid.Column="1"
			Width="6"
			HorizontalAlignment="Center"
			Background="Transparent" />

		<Grid Grid.Column="2">
			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<TabControl
				x:Name="TabControl"
				Grid.Row="0"
				Background="Transparent"
				BorderThickness="0"
				Foreground="{DynamicResource PrimaryTextBrush}"
				ItemsSource="{Binding Tabs}">
				<TabControl.ItemContainerStyle>
					<Style TargetType="TabItem">
						<Setter Property="HorizontalContentAlignment" Value="Stretch" />
					</Style>
				</TabControl.ItemContainerStyle>
				<!--  Tab 标题模板  -->
				<TabControl.ItemTemplate>
					<DataTemplate>
						<TextBlock
							Padding="10,5"
							HorizontalAlignment="Stretch"
							Background="Transparent"
							FontSize="14"
							Foreground="{DynamicResource PrimaryTextBrush}"
							Text="{Binding Header}" />
					</DataTemplate>
				</TabControl.ItemTemplate>

				<!--  Tab 内容模板  -->
				<TabControl.ContentTemplate>
					<DataTemplate>
						<Grid Margin="5">
							<Grid.RowDefinitions>
								<RowDefinition Height="*" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>

							<hc:PropertyGrid
								Grid.Row="0"
								HorizontalAlignment="Stretch"
								Background="Transparent"
								Foreground="{DynamicResource PrimaryTextBrush}"
								SelectedObject="{Binding ConfigObject}"
								ShowSortButton="False" />

							<!--  动态按钮区域  -->
							<ItemsControl
								Grid.Row="1"
								Margin="0,10,0,0"
								ItemsSource="{Binding Buttons}">

								<!--  1. 布局面板修改为 UniformGrid  -->
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<UniformGrid VerticalAlignment="Top" Columns="3" />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>

								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Button
											Height="36"
											Margin="2"
											Command="{Binding Command}"
											Content="{Binding Text}" />
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

						</Grid>
					</DataTemplate>
				</TabControl.ContentTemplate>
			</TabControl>
			<Border
				Grid.Row="1"
				BorderThickness="1"
				CornerRadius="4">

				<StackPanel>
					<ItemsControl ItemsSource="{Binding GlobalButtons}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<UniformGrid VerticalAlignment="Top" Columns="3" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Button
									Height="36"
									Margin="2"
									Command="{Binding Command}"
									Content="{Binding Text}" />
							</DataTemplate>
						</ItemsControl.ItemTemplate>

					</ItemsControl>
				</StackPanel>
			</Border>
			<Border Grid.Row="2">
				<StackPanel>
					<UniformGrid Columns="4" Rows="1">
						<Button
							x:Name="Vbut_SetMode"
							Height="36"
							Margin="2"
							Content="设为基准" />
						<Button
							x:Name="Vbut_inspect"
							Height="36"
							Margin="2"
							Content="检测"
							RenderTransformOrigin="0.5,0.5" />
						<Button
							x:Name="Vbut_UnLineInsp"
							Height="36"
							Margin="2"
							Content="离线检测" />
						<Button
							x:Name="Vbut_Exit"
							Height="36"
							Margin="2,4,2,0"
							Click="BackButton_Click"
							Content="完成退出" />
					</UniformGrid>

				</StackPanel>
			</Border>
		</Grid>
	</Grid>
</UserControl>